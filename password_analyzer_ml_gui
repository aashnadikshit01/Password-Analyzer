import tkinter as tk
from tkinter import ttk
import numpy as np
from password_analyzer_ml import PasswordAnalyzerML


class PasswordAnalyzerMLGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Password Strength Analyzer")

        # Set up the root window properties
        self.root.minsize(700, 800)  # Define the minimum size for usability across devices
        self.root.resizable(True, True)  # Enable dynamic resizing of the window

        # Configure the grid to allow resizing of components
        self.root.grid_rowconfigure(0, weight=1)
        self.root.grid_columnconfigure(0, weight=1)

        # Define the color scheme for consistent UI theming
        self.colors = {
            'bg': '#FFE4E1',  # Background color
            'button': '#FFB6C1',  # Button background
            'frame': '#FFC0CB',  # Frame background
            'text': '#FF69B4',  # Text color
            'entry': '#FFE4E8'  # Entry field background
        }

        # Show temporary loading message while initializing the ML model
        loading_label = tk.Label(
            root,
            text="Loading ML Model...\nThis may take a few moments.",
            font=('Futura', 14),
            fg=self.colors['text'],
            bg=self.colors['bg']
        )
        loading_label.pack(expand=True)
        root.update()

        # Initialize the machine learning-based password analyzer
        self.analyzer = PasswordAnalyzerML()

        # Remove the loading label after initialization is complete
        loading_label.destroy()

        # Apply the background color to the main window
        self.root.configure(bg=self.colors['bg'])

        # Configure ttk styles for consistent widget design
        self.style = ttk.Style()
        self.style.configure('TFrame', background=self.colors['frame'])
        self.style.configure('TLabel',
                             background=self.colors['frame'],
                             foreground=self.colors['text'],
                             font=('Futura', 10))
        self.style.configure('Title.TLabel',
                             font=('Futura', 18, 'bold'),
                             background=self.colors['bg'],
                             foreground=self.colors['text'])

        # Create a scrollable canvas to accommodate dynamic content
        self.main_canvas = tk.Canvas(
            root,
            bg=self.colors['bg'],
            highlightthickness=0
        )
        self.scrollbar = ttk.Scrollbar(
            root,
            orient="vertical",
            command=self.main_canvas.yview
        )

        # Frame for holding all scrollable widgets
        self.scrollable_frame = ttk.Frame(self.main_canvas)
        self.scrollable_frame.bind(
            "<Configure>",
            lambda e: self._configure_scroll_region()
        )

        # Embed the scrollable frame into the canvas
        self.canvas_frame = self.main_canvas.create_window(
            (0, 0),
            window=self.scrollable_frame,
            anchor="nw",
            width=self.root.winfo_width()
        )

        # Connect scrollbar with the canvas for smooth scrolling
        self.main_canvas.configure(yscrollcommand=self.scrollbar.set)

        # Adjust the canvas when resized
        self.main_canvas.bind('<Configure>', self._on_canvas_configure)

        # Add the canvas and scrollbar to the main window layout
        self.main_canvas.grid(row=0, column=0, sticky="nsew")
        self.scrollbar.grid(row=0, column=1, sticky="ns")

        # Create the main GUI widgets
        self._create_widgets()

    def _configure_scroll_region(self):
        """Adjust the scroll region dynamically based on frame size."""
        self.main_canvas.configure(
            scrollregion=self.main_canvas.bbox("all")
        )

    def _on_canvas_configure(self, event):
        """Update canvas frame dimensions to match window resizing."""
        self.main_canvas.itemconfig(
            self.canvas_frame,
            width=event.width
        )

    def _bind_mouse_scroll(self, event):
        """Enable mouse scroll binding within the scrollable frame."""
        self.main_canvas.bind_all("<MouseWheel>", self._on_mouse_scroll)

    def _unbind_mouse_scroll(self, event):
        """Disable mouse scroll binding when leaving the scrollable frame."""
        self.main_canvas.unbind_all("<MouseWheel>")

    def _on_mouse_scroll(self, event):
        """Handle vertical scrolling based on mouse wheel input."""
        self.main_canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")

    def _create_widgets(self):
        # Bind mouse scroll events to improve usability within the frame
        self.scrollable_frame.bind('<Enter>', self._bind_mouse_scroll)
        self.scrollable_frame.bind('<Leave>', self._unbind_mouse_scroll)

        # Display the title of the application prominently
        title = ttk.Label(
            self.scrollable_frame,
            text="Password Strength Analyzer",
            style='Title.TLabel'
        )
        title.pack(pady=20)

        # Input frame to group related widgets logically
        input_frame = ttk.Frame(self.scrollable_frame)
        input_frame.pack(fill=tk.X, padx=20, pady=10)

        # Password input field with obscured characters for security
        self.password_var = tk.StringVar()
        self.password_entry = tk.Entry(
            input_frame,
            textvariable=self.password_var,
            show="•",  # Obscure input for privacy
            width=40,
            font=('Futura', 12),
            bg=self.colors['entry'],
            fg=self.colors['text']
        )
        self.password_entry.pack(pady=5)

        # Option to toggle visibility of the entered password
        self.show_password = tk.BooleanVar()
        show_pwd_cb = tk.Checkbutton(
            input_frame,
            text="Show password",
            variable=self.show_password,
            command=self._toggle_password_visibility,
            font=('Futura', 10),
            bg=self.colors['frame'],
            fg=self.colors['text']
        )
        show_pwd_cb.pack()

        # Button to trigger password analysis using the ML model
        analyze_btn = tk.Button(
            input_frame,
            text="Analyze Password",
            command=self._analyze_password,
            bg=self.colors['button'],
            fg=self.colors['text'],
            font=('Futura', 12),
            relief='flat',
            padx=20,
            pady=5
        )
        analyze_btn.pack(pady=10)

        # Frame to display analysis results
        self.results_frame = ttk.Frame(self.scrollable_frame)
        self.results_frame.pack(fill=tk.X, padx=20, pady=10)

        # Labels for various password strength metrics
        self.strength_label = ttk.Label(self.results_frame, text="Strength: ")
        self.strength_label.pack(anchor='w', pady=2)

        self.score_label = ttk.Label(self.results_frame, text="Score: ")
        self.score_label.pack(anchor='w', pady=2)

        self.entropy_label = ttk.Label(self.results_frame, text="Entropy: ")
        self.entropy_label.pack(anchor='w', pady=2)

        self.crack_time_label = ttk.Label(self.results_frame, text="Crack Time: ")
        self.crack_time_label.pack(anchor='w', pady=2)

        # Frame to display feature-level analysis details
        self.feature_frame = ttk.Frame(self.scrollable_frame)
        self.feature_frame.pack(fill=tk.X, padx=20, pady=10)

        # Frame for additional feedback and suggestions
        self.feedback_frame = ttk.Frame(self.scrollable_frame)
        self.feedback_frame.pack(fill=tk.X, padx=20, pady=10)

        self.feedback_label = ttk.Label(
            self.feedback_frame,
            text="Enter a password to see feedback",
            wraplength=600,  # Wrap text for readability
            font=('Futura', 10),
            justify='left',
            anchor='w'
        )
        self.feedback_label.pack(fill=tk.X, expand=True, padx=10, pady=5)

    def _toggle_password_visibility(self):
        """Toggle visibility of password input field."""
        self.password_entry.config(show="" if self.show_password.get() else "•")

    def _analyze_password(self):
        password = self.password_var.get()

        if not password:
            self.feedback_label.config(text="Please enter a password to analyze")
            return

        # Perform password analysis using the ML model
        results = self.analyzer.get_password_strength(password)

        # Update the GUI with the analysis results
        self.strength_label.config(text=f"Strength: {results['strength']}")
        self.score_label.config(text=f"Score: {results['score']:.2f}/5")
        self.entropy_label.config(text=f"Entropy: {results['entropy']:.2f} bits")
        self.crack_time_label.config(text=f"Estimated crack time: {results['crack_time_estimate']}")

        # Provide feedback and recommendations
        feedback = self._generate_feedback(password, results)
        feedback_text = "\n".join(feedback)
        self.feedback_label.config(text=feedback_text)

        # Update feature-level analysis for visualization
        self._update_feature_importance()

