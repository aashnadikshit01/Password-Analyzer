    def _update_feature_importance(self):
        """Display a detailed feature breakdown with normalized scores."""
        # Clear previous metrics before displaying new ones
        for widget in self.feature_frame.winfo_children():
            widget.destroy()

        # Configure the progress bar style for visual representation
        self.style.configure(
            "Pink.Horizontal.TProgressbar",
            background=self.colors['text'],
            troughcolor=self.colors['entry']
        )

    # Title
        ttk.Label(
            self.feature_frame,
            text="Password Feature Analysis",
            style='Title.TLabel'
        ).pack(pady=(10, 20))

        password = self.password_var.get()
        if not password:
            return

        # Calculate metrics for all features
        metrics = {
            'Length': len(password),
            'Uppercase': sum(1 for c in password if c.isupper()),
            'Lowercase': sum(1 for c in password if c.islower()),
            'Digits': sum(1 for c in password if c.isdigit()),
            'Special Chars': sum(1 for c in password if not c.isalnum()),
            'Entropy': self.analyzer.calculate_entropy(password),
            'Char Diversity': len(set(password)) / len(password) if password else 0,
            'Sequential Chars': self._calculate_sequential_chars(password),
            'Repeated Chars': self._calculate_repeated_chars(password),
            'Common Password': int(password.lower() in self.analyzer.common_passwords)
        }

        # Normalize the metrics
        max_values = {
            'Length': 20,  # reasonable max length
            'Uppercase': 10,
            'Lowercase': 10,
            'Digits': 10,
            'Special Chars': 5,
            'Entropy': 5,
            'Char Diversity': 1,
            'Sequential Chars': 1,
            'Repeated Chars': 1,
            'Common Password': 1
        }

        normalized_metrics = {
            k: min(v / max_values[k], 1.0) for k, v in metrics.items()
        }

        # Sort by importance
        sorted_metrics = dict(sorted(normalized_metrics.items(), key=lambda x: x[1], reverse=True))

        # Create display for each metric
        for feature, value in sorted_metrics.items():
            feature_frame = ttk.Frame(self.feature_frame)
            feature_frame.pack(fill=tk.X, padx=20, pady=5)

            # Feature name and original value
            original_value = metrics[feature]
            name_label = ttk.Label(
                feature_frame,
                text=f"{feature} ({original_value:.2f})",
                font=('Futura', 10),
                width=30,
                anchor='e'
            )
            name_label.pack(side=tk.LEFT, padx=(0, 10))

            # Progress bar
            progress = ttk.Progressbar(
                feature_frame,
                length=200,
                mode='determinate',
                style="Pink.Horizontal.TProgressbar"
            )
            progress.pack(side=tk.LEFT, padx=5)
            progress['value'] = value * 100

            # Percentage
            value_label = ttk.Label(
                feature_frame,
                text=f"{value:.1%}",
                font=('Futura', 10)
            )
            value_label.pack(side=tk.LEFT, padx=5)


def main():
    root = tk.Tk()
    app = PasswordAnalyzerMLGUI(root)
    root.mainloop()


if __name__ == "__main__":
    main()
